     4	/**
     5	 * Append-only event stream + optional tee for realtime observability.
     6	 */
     7	const STREAM_EVENT_TYPES = new Set(['worker.output', 'worker.stderr']);
     8	
     9	export class EventSink {
    10	  #eventsPath;
    11	  #tee;
    12	  #persistWorkerStream;
    13	
    14	  constructor(runRoot, { tee = false, persistWorkerStream = false } = {}) {
    15	    this.#eventsPath = path.join(runRoot, 'events.jsonl');
    16	    this.#tee = tee;
    17	    this.#persistWorkerStream = persistWorkerStream;
    18	    fs.mkdirSync(runRoot, { recursive: true });
    19	    if (!fs.existsSync(this.#eventsPath)) {
    20	      fs.writeFileSync(this.#eventsPath, '');
    21	    }
    22	  }
    23	
    24	  emit(type, payload = {}) {
    25	    const event = {
    26	      ts: new Date().toISOString(),
    27	      type,
    28	      ...payload,
    29	    };
    30	    const line = `${JSON.stringify(event)}\n`;
    31	    const isStreamChunk = STREAM_EVENT_TYPES.has(type);
    32	    if (!isStreamChunk || this.#persistWorkerStream) {
    33	      fs.appendFileSync(this.#eventsPath, line);
    34	    }
    35	    if (this.#tee) {
    36	      process.stderr.write(`[zedpstack] ${line}`);
    37	    }
    38	    return event;
    39	  }
    40	}
