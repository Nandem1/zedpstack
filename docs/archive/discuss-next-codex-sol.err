    30	export function shouldDisplayEvent(type) {
    31	  return Boolean(type && HUMAN_TYPES.has(type));
    32	}
    33	
    34	export function isTerminalRunEvent(type) {
    35	  return TERMINAL_RUN_EVENTS.has(type);
