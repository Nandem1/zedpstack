    59	/**
    60	 * @param {string} text full sheet body
    61	 * @returns {{ roles: Record<string, string[]>, defaultEffort: string|null, sessionHook: string|null, droppedLines: string[] }}
    62	 */
    63	export function parseModelSheet(text) {
    64	  const roles = {};
    65	  let defaultEffort = null;
    66	  let sessionHook = null;
    67	  const droppedLines = [];
    68	
    69	  for (const line of text.split('\n')) {
    70	    const stripped = line.trim();
    71	    if (!stripped || stripped.startsWith('#')) continue;
    72	    if (stripped.startsWith('---')) continue;
    73	
    74	    const colon = stripped.indexOf(':');
    75	    if (colon < 0) {
    76	      droppedLines.push(stripped);
    77	      continue;
    78	    }
    79	    const key = stripped.slice(0, colon).trim().toLowerCase();
    80	    const value = stripped.slice(colon + 1).trim();
    81	
    82	    if (key === 'default effort') {
    83	      defaultEffort = value;
    84	      continue;
    85	    }
    86	    if (key === 'session hook') {
    87	      sessionHook = value;
    88	      continue;
    89	    }
    90	
    91	    const parts = value.split(',').map((p) => p.trim()).filter(Boolean);
    92	    roles[key] = parts;
    93	  }
    94	
    95	  return { roles, defaultEffort, sessionHook, droppedLines };
    96	}
