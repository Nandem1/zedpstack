    38	function previewChunk(chunk, maxLen = 120) {
    39	  const preview = chunk.replace(/\s+/g, ' ').slice(0, maxLen);
    40	  return `${preview}${chunk.length > maxLen ? '…' : ''}`;
    41	}
    42	
    43	export function formatEvent(event) {
    44	  const { ts, type, stepId, workerId, runtime, model, status, errors, chunk } = event;
    45	  const head = `[${ts}] ${type}`;
    46	  const parts = [head];
    47	  if (stepId) parts.push(`step=${stepId}`);
    48	  if (workerId) parts.push(`worker=${workerId}`);
    49	  if (runtime) parts.push(`${runtime}/${model ?? '?'}`);
    50	  if (status) parts.push(`status=${status}`);
    51	  if (errors?.length) parts.push(`errors=${errors.join('; ')}`);
    52	  if ((type === 'worker.output' || type === 'worker.stderr') && chunk) {
    53	    parts.push(`| ${previewChunk(chunk)}`);
    54	  }
    55	  return parts.join(' ');
    56	}
    57	
    58	function readGrowth(eventsPath, offset, buf) {
    59	  let nextOffset = offset;
    60	  let buffer = buf;
    61	  let st = fs.statSync(eventsPath);
    62	  while (st.size > nextOffset) {
    63	    const fd = fs.openSync(eventsPath, 'r');
    64	    const len = st.size - nextOffset;
    65	    const chunk = Buffer.alloc(len);
    66	    const bytesRead = fs.readSync(fd, chunk, 0, len, nextOffset);
    67	    fs.closeSync(fd);
    68	    nextOffset += bytesRead;
    69	    buffer += chunk.subarray(0, bytesRead).toString('utf8');
    70	    st = fs.statSync(eventsPath);
    71	  }
    72	  return { offset: nextOffset, buf: buffer };
    73	}
    74	
    75	/**
    76	 * Follow events.jsonl for a run (like tee-events, but readable).
    77	 */
    78	export async function watchRun({
    79	  repoRoot,
    80	  runId,
    81	  fromStart = false,
    82	  follow = true,
    83	  pollMs = 500,
    84	  writeLine = (line) => process.stderr.write(`${line}\n`),
    85	}) {
    86	  const eventsPath = path.join(runDir(repoRoot, runId), 'events.jsonl');
    87	  if (!fs.existsSync(eventsPath)) {
    88	    throw new Error(`No events at ${eventsPath}`);
    89	  }
    90	
    91	  let offset = fromStart ? 0 : fs.statSync(eventsPath).size;
    92	  let buf = '';
    93	  let sawTerminal = false;
    94	
    95	  const drain = () => {
    96	    const lines = buf.split('\n');
    97	    buf = lines.pop() ?? '';
    98	    for (const line of lines) {
    99	      if (!line.trim()) continue;
   100	      let event;
   101	      try {
   102	        event = JSON.parse(line);
   103	      } catch {
   104	        continue;
   105	      }
   106	      if (shouldDisplayEvent(event.type)) {
   107	        writeLine(formatEvent(event));
   108	      }
   109	      if (isTerminalRunEvent(event.type)) {
   110	        sawTerminal = true;
   111	      }
   112	    }
   113	  };
   114	
   115	  const pull = () => {
   116	    const grown = readGrowth(eventsPath, offset, buf);
   117	    offset = grown.offset;
   118	    buf = grown.buf;
   119	    drain();
   120	    return sawTerminal;
   121	  };
   122	
   123	  if (fromStart) {
   124	    pull();
   125	  }
   126	
   127	  if (!follow) return;
   128	
   129	  if (sawTerminal) return;
   130	
   131	  return new Promise((resolve) => {
   132	    let interval;
   133	    const stop = () => {
   134	      if (interval) clearInterval(interval);
   135	      resolve();
   136	    };
   137	
   138	    const tick = () => {
   139	      try {
   140	        if (pull()) stop();
   141	      } catch {
   142	        stop();
   143	      }
   144	    };
