import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { loadConfig } from './config.mjs';
import {
  bindingsFromSheet,
  defaultSheetTemplate,
  parseModelSheet,
  sheetBindingOverflowWarnings,
} from './modelSheet.mjs';
import { zedpstackRoot } from './paths.mjs';

export function defaultModelSheetPath() {
  const cursor = path.join(os.homedir(), '.cursor', 'rules', 'pstack-models.mdc');
  if (fs.existsSync(cursor)) return cursor;
  const plain = path.join(os.homedir(), '.cursor', 'rules', 'pstack-models.md');
  if (fs.existsSync(plain)) return plain;
  return path.join(os.homedir(), '.zedpstack', 'pstack-models.md');
}

export function readModelSheet(filePath) {
  const resolved = path.resolve(filePath);
  if (!fs.existsSync(resolved)) {
    return { path: resolved, text: defaultSheetTemplate(), exists: false };
  }
  let text = fs.readFileSync(resolved, 'utf8');
  if (resolved.endsWith('.mdc')) {
    text = text.replace(/^---[\s\S]*?---\s*/m, '');
  }
  return { path: resolved, text, exists: true };
}

/**
 * Merge sheet bindings into zedpstack.config.json (preserves timeouts / unknown roles).
 */
export function applyModelSheetToConfig({
  sheetPath,
  configPath,
  allowMissingSheet = false,
} = {}) {
  const resolvedPath = sheetPath ?? process.env.ZEDPSTACK_MODEL_SHEET ?? defaultModelSheetPath();
  const sheet = readModelSheet(resolvedPath);
  if (!sheet.exists && !allowMissingSheet) {
    throw new Error(
      `Model sheet not found at ${sheet.path}. Run "dispatch setup init" or pass --file.`,
    );
  }
  const parsed = parseModelSheet(sheet.text);
  const { bindings, overflows } = bindingsFromSheet(parsed);

  const cfgFile =
    configPath ??
    process.env.ZEDPSTACK_CONFIG ??
    path.join(zedpstackRoot(), 'zedpstack.config.json');

  let configData = { roles: {}, timeouts: {} };
  if (fs.existsSync(cfgFile)) {
    configData = JSON.parse(fs.readFileSync(cfgFile, 'utf8'));
  }
  configData.roles = { ...(configData.roles ?? {}), ...bindings };
  if (!configData.$schema) {
    configData.$schema = './schemas/config.schema.json';
  }

  fs.mkdirSync(path.dirname(cfgFile), { recursive: true });
  fs.writeFileSync(cfgFile, `${JSON.stringify(configData, null, 2)}\n`, 'utf8');

  return {
    sheetPath: sheet.path,
    sheetExists: sheet.exists,
    configPath: cfgFile,
    rolesUpdated: Object.keys(bindings),
    overflows,
    overflowWarnings: overflows.length
      ? sheetBindingOverflowWarnings(overflows)
      : [],
    defaultEffort: parsed.defaultEffort,
    sessionHook: parsed.sessionHook,
    droppedLines: parsed.droppedLines,
  };
}

export function initModelSheet(filePath) {
  const target = path.resolve(filePath ?? defaultModelSheetPath());
  fs.mkdirSync(path.dirname(target), { recursive: true });
  if (!fs.existsSync(target)) {
    const body = defaultSheetTemplate();
    if (target.endsWith('.mdc')) {
      fs.writeFileSync(
        target,
        `---
description: pstack per-role model choices (zedpstack sync)
alwaysApply: true
---
${body}`,
        'utf8',
      );
    } else {
      fs.writeFileSync(target, body, 'utf8');
    }
  }
  return target;
}

export function showSetupStatus() {
  const sheet = readModelSheet(
    process.env.ZEDPSTACK_MODEL_SHEET ?? defaultModelSheetPath(),
  );
  const { path: cfgPath, data } = loadConfig();
  return {
    modelSheet: sheet.path,
    modelSheetExists: sheet.exists,
    configPath: cfgPath,
    roleCount: Object.keys(data.roles ?? {}).length,
    roles: data.roles ?? {},
  };
}
/**
 * Parse / write pstack-compatible model override sheets (setup-pstack shape).
 * Maps sheet roles to zedpstack RoleBinding keys for dispatch workers.
 */

const EFFORT_LEVELS = new Set(['low', 'medium', 'high', 'xhigh', 'max']);

/** pstack sheet role label → zedpstack config role ids */
export const SHEET_TO_ZEDPSTACK_ROLES = {
  'how explorer': ['how-explorer', 'explorer'],
  'how explainer': ['how-explainer', 'synthesizer'],
  'why investigators': ['why-investigator'],
  'why synthesizer': ['why-synthesizer'],
  'architect runners': ['architect-runner-a', 'architect-runner-b'],
  'interrogate reviewers': [
    'interrogate-reviewer-a',
    'interrogate-reviewer-b',
    'interrogate-reviewer-c',
  ],
  'reflect tooling': ['reflect-reviewer-tooling'],
  'reflect judgment': ['reflect-reviewer-judgment'],
  'reflect divergent': ['reflect-reviewer-divergent'],
  'reflect synthesizer': ['reflect-synthesize'],
  'reflect judgment, divergent, synthesizer': [
    'reflect-reviewer-judgment',
    'reflect-reviewer-divergent',
    'reflect-synthesize',
  ],
  'architect ground': ['architect-ground'],
  'architect synthesize': ['architect-synthesize'],
  'interrogate lead': ['interrogate-lead'],
};

/** One model on these rows applies to every mapped zed role (not a positional panel). */
const SHARED_SHEET_ROLES = new Set(['reflect judgment, divergent, synthesizer']);

/** List length sets subagent count; extra entries must not overwrite the last slot. */
const PANEL_SHEET_ROLES = new Set(['architect runners', 'interrogate reviewers']);

/**
 * @param {string} slugWithOptionalEffort e.g. "haiku @high" or "gpt-6.1-sol"
 */
export function parseModelValue(raw) {
  const trimmed = raw.trim();
  if (!trimmed || trimmed === 'inherit-parent' || trimmed === 'auto') {
    return { model: trimmed, effort: null };
  }
  const at = trimmed.lastIndexOf(' @');
  if (at > 0) {
    const model = trimmed.slice(0, at).trim();
    const effort = trimmed.slice(at + 2).trim().toLowerCase();
    if (EFFORT_LEVELS.has(effort)) {
      return { model, effort };
    }
  }
  return { model: trimmed, effort: null };
}

/**
 * @param {string} text full sheet body
 * @returns {{ roles: Record<string, string[]>, defaultEffort: string|null, sessionHook: string|null, droppedLines: string[] }}
 */
export function parseModelSheet(text) {
  const roles = {};
  let defaultEffort = null;
  let sessionHook = null;
  const droppedLines = [];

  for (const line of text.split('\n')) {
    const stripped = line.trim();
    if (!stripped || stripped.startsWith('#')) continue;
    if (stripped.startsWith('---')) continue;

    const colon = stripped.indexOf(':');
    if (colon < 0) {
      droppedLines.push(stripped);
      continue;
    }
    const key = stripped.slice(0, colon).trim().toLowerCase();
    const value = stripped.slice(colon + 1).trim();

    if (key === 'default effort') {
      defaultEffort = value;
      continue;
    }
    if (key === 'session hook') {
      sessionHook = value;
      continue;
    }

    const parts = value.split(',').map((p) => p.trim()).filter(Boolean);
    roles[key] = parts;
  }

  return { roles, defaultEffort, sessionHook, droppedLines };
}

/**
 * Infer CLI runtime from model slug (heuristic; user can override in config).
 */
export function inferRuntimeForModel(model) {
  if (!model || model === 'inherit-parent' || model === 'auto') {
    return 'claude';
  }
  const s = model.toLowerCase();
  if (
    s.includes('gpt') ||
    s.includes('codex') ||
    s.includes('-sol') ||
    s.includes('o3') ||
    s.includes('o4') ||
    s.startsWith('chatgpt')
  ) {
    return 'codex';
  }
  return 'claude';
}

function bindingForModel(raw, globalEffort) {
  const { model, effort } = parseModelValue(raw);
  if (!model || model === 'inherit-parent' || model === 'auto') {
    return null;
  }
  const binding = {
    runtime: inferRuntimeForModel(model),
    model,
    permissionProfile: 'read-only',
  };
  const eff = effort ?? globalEffort;
  if (eff) binding.effort = eff;
  return binding;
}

/**
 * Human-readable warnings for panel overflow (extra models with no slot).
 * @param {{ sheetRole: string, model: string, index: number }[]} overflows
 */
export function sheetBindingOverflowWarnings(overflows) {
  return overflows.map(
    (entry) =>
      `Sheet row "${entry.sheetRole}" has more models than slots; ignored "${entry.model}" at position ${entry.index + 1}.`,
  );
}

/**
 * Build zedpstack config role entries from a parsed sheet.
 * @returns {{
 *   bindings: Record<string, { runtime: string, model: string, permissionProfile: string, effort?: string }>,
 *   overflows: { sheetRole: string, model: string, index: number }[],
 * }}
 */
export function bindingsFromSheet(parsed, { defaultEffort = 'session' } = {}) {
  const globalEffort =
    parsed.defaultEffort && parsed.defaultEffort !== 'session'
      ? parsed.defaultEffort
      : defaultEffort !== 'session'
        ? defaultEffort
        : null;

  const out = {};
  const overflows = [];

  for (const [sheetRole, values] of Object.entries(parsed.roles)) {
    const zedRoles = SHEET_TO_ZEDPSTACK_ROLES[sheetRole];
    if (!zedRoles?.length) continue;

    const usable = values
      .map((raw) => ({ raw, binding: bindingForModel(raw, globalEffort) }))
      .filter((entry) => entry.binding);

    if (SHARED_SHEET_ROLES.has(sheetRole) && usable.length === 1) {
      const binding = usable[0].binding;
      for (const targetRole of zedRoles) {
        out[targetRole] = binding;
      }
      continue;
    }

    const panel = PANEL_SHEET_ROLES.has(sheetRole);

    usable.forEach(({ raw, binding }, index) => {
      if (panel && index >= zedRoles.length) {
        overflows.push({
          sheetRole,
          model: parseModelValue(raw).model,
          index,
        });
        return;
      }
      const targetRole = panel
        ? zedRoles[index]
        : (zedRoles[index] ?? zedRoles[zedRoles.length - 1]);
      out[targetRole] = binding;
    });
  }

  return { bindings: out, overflows };
}

export function defaultSheetTemplate() {
  return `# pstack model configuration (zedpstack sync)

how explorer: haiku
how explainer: gpt-6.1-sol
why investigators: gpt-6.1-sol
why synthesizer: haiku
architect ground: haiku
architect runners: gpt-6.1-sol, haiku
architect synthesize: gpt-6.1-sol
interrogate reviewers: haiku, haiku, haiku
interrogate lead: gpt-6.1-sol
reflect tooling: haiku
reflect judgment: haiku
reflect divergent: haiku
reflect synthesizer: haiku

default effort: session
session hook: on
`;
}
import fs from 'node:fs';
import path from 'node:path';
import { zedpstackRoot } from './paths.mjs';

export function loadConfig() {
  const candidates = [
    process.env.ZEDPSTACK_CONFIG,
    path.join(zedpstackRoot(), 'zedpstack.config.json'),
    path.join(zedpstackRoot(), 'zedpstack.config.local.json'),
  ].filter(Boolean);

  for (const file of candidates) {
    if (fs.existsSync(file)) {
      const raw = fs.readFileSync(file, 'utf8');
      return { path: file, data: JSON.parse(raw) };
    }
  }

  const example = path.join(zedpstackRoot(), 'zedpstack.config.example.json');
  if (fs.existsSync(example)) {
    return { path: example, data: JSON.parse(fs.readFileSync(example, 'utf8')) };
  }

  throw new Error(
    'No zedpstack config found. Copy zedpstack.config.example.json to zedpstack.config.json',
  );
}

/**
 * @returns {import('./types.mjs').RoleBinding}
 */
const ROLE_BINDING_ALIASES = {
  'how-explorer': 'explorer',
  'how-explainer': 'synthesizer',
  'why-investigator': 'explorer',
  'why-synthesizer': 'synthesizer',
  'architect-ground': 'explorer',
  'architect-runner': 'explorer',
  'architect-synthesize': 'synthesizer',
  'interrogate-reviewer': 'explorer',
  'interrogate-reviewer-a': 'interrogate-reviewer',
  'interrogate-reviewer-b': 'interrogate-reviewer',
  'interrogate-reviewer-c': 'interrogate-reviewer',
  'interrogate-lead': 'synthesizer',
  'reflect-reviewer': 'explorer',
  'reflect-reviewer-judgment': 'reflect-reviewer',
  'reflect-reviewer-tooling': 'reflect-reviewer',
  'reflect-reviewer-divergent': 'reflect-reviewer',
  'reflect-synthesize': 'synthesizer',
  'architect-runner-a': 'architect-runner',
  'architect-runner-b': 'architect-runner',
};

export function resolveRoleBindingKey(roles, role) {
  const seen = new Set();
  let current = role;
  while (current && !seen.has(current)) {
    seen.add(current);
    if (roles[current]) {
      return current;
    }
    current = ROLE_BINDING_ALIASES[current];
  }
  return null;
}

export function resolveRoleBinding(config, role) {
  const roles = config.data.roles ?? {};
  const key = resolveRoleBindingKey(roles, role);
  const binding = key ? roles[key] : undefined;
  if (!binding?.runtime || !binding?.model || !binding?.permissionProfile) {
    throw new Error(`Missing RoleBinding for role "${role}" in config`);
  }
  const out = {
    runtime: binding.runtime,
    model: binding.model,
    permissionProfile: binding.permissionProfile,
  };
  if (binding.effort) {
    out.effort = binding.effort;
  }
  return out;
}

export function resolveTimeout(config, role) {
  const timeouts = config.data.timeouts ?? {};
  const seen = new Set();
  let current = role;
  while (current && !seen.has(current)) {
    seen.add(current);
    if (typeof timeouts[current] === 'number') {
      return timeouts[current];
    }
    current = ROLE_BINDING_ALIASES[current];
  }
  return 600_000;
}
