import fs from 'node:fs';
import path from 'node:path';
import { randomUUID } from 'node:crypto';
import { loadConfig, resolveRoleBinding, resolveTimeout } from './config.mjs';
import { EventSink } from './events/sink.mjs';
import { tryGitCommit } from './git.mjs';
import {
  computeRepoSourceFingerprint,
  computeStepIdentity,
  sha256Hex,
} from './hash.mjs';
import {
  JUDGMENT_INSTRUCTIONS_FILE,
  ORCHESTRATOR_JUDGMENT_FILE,
  validateOrchestratorJudgment,
} from './judgment.mjs';
import {
  createInitialManifest,
  readManifest,
  updateManifestStep,
  writeManifestAtomic,
} from './manifest.mjs';
import {
  attachPstackUpstreamMeta,
  loadPlaybook,
  loadPrompt,
  loadStepPrompt,
} from './playbook.mjs';
import { resolvePstackInstall } from './pstack.mjs';
import { validationProfileForRole } from './roles.mjs';
import { runDir, workerDir, zedpstackRoot } from './paths.mjs';
import {
  canReuseCompletedStep,
  resultPathForStep,
  stdoutLogForStep,
} from './resume.mjs';
import { runWorkerForBinding } from './runtimes/index.mjs';
import { validateWorkerResult } from './validation.mjs';

function initStepRecords(playbookDef, config) {
  return playbookDef.steps.map((step) => {
    const binding = resolveRoleBinding(config, step.role);
    return {
      stepId: step.id,
      role: step.role,
      status: 'pending',
      stepIdentityHash: null,
      binding,
      attempts: [],
    };
  });
}

function findStepDef(playbookDef, stepId) {
  const s = playbookDef.steps.find((x) => x.id === stepId);
  if (!s) throw new Error(`Unknown step ${stepId}`);
  return s;
}

function buildInputRefs(runRoot, stepDef, playbookDef) {
  const inputRefs = [];
  if (!stepDef.inputFrom?.length) return inputRefs;

  for (const fromId of stepDef.inputFrom) {
    const prevResult = resultPathForStep(runRoot, fromId);
    if (!fs.existsSync(prevResult)) {
      throw new Error(`Upstream step ${fromId} result missing for ${stepDef.id}`);
    }
    const raw = fs.readFileSync(prevResult, 'utf8');
    const parsed = JSON.parse(raw);
    const upstreamStep = playbookDef.steps.find((s) => s.id === fromId);
    const upstreamRole = upstreamStep
      ? validationProfileForRole(upstreamStep.role)
      : null;
    const upstreamValidation = validateWorkerResult({
      exitCode: parsed.exitCode ?? 0,
      resultPath: prevResult,
      outputContract: 'markdown-report',
      processExited: true,
      role: upstreamStep?.role ?? null,
      validationProfile: upstreamRole,
      stdoutLogPath: stdoutLogForStep(runRoot, fromId),
    });
    if (!upstreamValidation.valid) {
      throw new Error(
        `Upstream step ${fromId} invalid: ${upstreamValidation.errors.join('; ')}`,
      );
    }
    inputRefs.push({ path: prevResult, hash: sha256Hex(raw) });
  }
  return inputRefs;
}

function loadPriorTexts(runRoot, stepDef) {
  const priorTexts = {};
  for (const fromId of stepDef.inputFrom ?? []) {
    const p = resultPathForStep(runRoot, fromId);
    priorTexts[fromId] = JSON.parse(fs.readFileSync(p, 'utf8')).text;
  }
  return priorTexts;
}

function preparePromptText({ stepDef, playbook, runRoot, repoRoot, goal, context }) {
  const priorTexts = stepDef.inputFrom?.length ? loadPriorTexts(runRoot, stepDef) : {};
  return loadStepPrompt({
    playbook,
    stepDef,
    goal,
    repoRoot,
    context,
    priorTexts,
  });
}

function manifestWasCancelled(runRoot) {
  if (!fs.existsSync(path.join(runRoot, 'manifest.json'))) {
    return false;
  }
  return readManifest(runRoot).status === 'cancelled';
}

function loadRunContext(runRoot) {
  const p = path.join(runRoot, 'context-input.md');
  if (!fs.existsSync(p)) {
    return '';
  }
  return fs.readFileSync(p, 'utf8');
}

async function executeStep({
  manifest,
  playbook,
  playbookDef,
  config,
  runRoot,
  repoRoot,
  goal,
  stepId,
  eventSink,
  runId,
}) {
  const context = loadRunContext(runRoot);
  if (manifestWasCancelled(runRoot)) {
    return readManifest(runRoot);
  }

  const stepRecord = manifest.steps.find((s) => s.stepId === stepId);
  const stepDef = findStepDef(playbookDef, stepId);
  const binding = resolveRoleBinding(config, stepDef.role);
  const inputRefs = buildInputRefs(runRoot, stepDef, playbookDef);
  const promptText = preparePromptText({
    stepDef,
    playbook,
    runRoot,
    repoRoot,
    goal,
    context,
  });

  const repoCommit = tryGitCommit(repoRoot);
  const repoSourceFingerprint = computeRepoSourceFingerprint(repoRoot);
  const stepIdentityHash = computeStepIdentity({
    playbookId: playbookDef.id,
    playbookVersion: playbookDef.version,
    stepId,
    goal,
    inputRefs,
    binding,
    renderedPrompt: promptText,
    repoCommit,
    repoSourceFingerprint,
    pstackVersion: playbookDef.upstream?.pstackVersion ?? null,
  });

  const resultPath = resultPathForStep(runRoot, stepId);
  const stdoutLog = stdoutLogForStep(runRoot, stepId);

  const reuse = canReuseCompletedStep({
    stepRecord,
    stepIdentityHash,
    resultPath,
    outputContract: stepDef.outputContract,
    role: stepDef.role,
    validationProfile: validationProfileForRole(stepDef.role),
    stdoutLogPath: stdoutLog,
  });

  if (reuse.reuse) {
    eventSink.emit('step.completed', { runId, stepId, resumed: true, reuse: true });
    const updated = updateManifestStep(manifest, stepId, {
      stepIdentityHash,
      lastErrors: null,
    });
    writeManifestAtomic(runRoot, updated);
    return updated;
  }

  if (
    reuse.reason === 'result_invalid' ||
    reuse.reason === 'result_missing' ||
    reuse.reason === 'identity_mismatch'
  ) {
    manifest = updateManifestStep(manifest, stepId, {
      status: 'pending',
      validResult: false,
    });
    writeManifestAtomic(runRoot, manifest);
  }

  eventSink.emit('step.started', { runId, stepId, stepIdentityHash });

  const taskSpec = {
    goal,
    inputRefs,
    outputContract: stepDef.outputContract,
    timeout: resolveTimeout(config, stepDef.role),
  };

  const wRoot = workerDir(runRoot, stepId);
  const workerId = `${stepId}-${Date.now()}`;
  const attempt = {
    workerId,
    startedAt: new Date().toISOString(),
    binding,
    taskSpec,
    stepIdentityHash,
  };

  let manifestPatched = updateManifestStep(manifest, stepId, {
    status: 'running',
    stepIdentityHash,
    attempts: [...stepRecord.attempts, attempt],
  });
  writeManifestAtomic(runRoot, manifestPatched);

  const patchAttemptPid = (pid) => {
    const stepNow = manifestPatched.steps.find((s) => s.stepId === stepId);
    const attemptsWithPid = [...stepNow.attempts];
    const lastIdx = attemptsWithPid.length - 1;
    if (lastIdx >= 0) {
      attemptsWithPid[lastIdx] = { ...attemptsWithPid[lastIdx], pid };
    }
    manifestPatched = updateManifestStep(manifestPatched, stepId, {
      attempts: attemptsWithPid,
    });
    writeManifestAtomic(runRoot, manifestPatched);
  };

  const outcome = await runWorkerForBinding({
    binding,
    taskSpec,
    workerRoot: wRoot,
    repoRoot: path.resolve(repoRoot),
    promptText,
    eventSink,
    workerId,
    runId,
    stepId,
    onWorkerSpawned: ({ pid }) => patchAttemptPid(pid),
  });

  if (manifestWasCancelled(runRoot)) {
    return readManifest(runRoot);
  }

  const validation = validateWorkerResult({
    exitCode: outcome.exitCode,
    resultPath: outcome.resultPath,
    outputContract: stepDef.outputContract,
    processExited: outcome.processExited,
    role: stepDef.role,
    validationProfile: validationProfileForRole(stepDef.role),
    stdoutLogPath: stdoutLog,
  });

  attempt.finishedAt = new Date().toISOString();
  attempt.exitCode = outcome.exitCode;
  attempt.validation = validation;
  attempt.cliVersion = outcome.cliVersion;

import { spawn } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { buildCodexArgv, workerEnv } from '../permissions.mjs';
import {
  accumulateCodexReadSignals,
  detectCodexShellInvocation,
  detectCodexShellMutation,
} from '../shellSignals.mjs';
import { appendChunk } from './stream.mjs';

export async function runCodexWorker({
  binding,
  taskSpec,
  workerRoot,
  repoRoot,
  promptText,
  eventSink,
  workerId,
  runId,
  stepId,
  onWorkerSpawned,
}) {
  const stdoutLog = path.join(workerRoot, 'stdout.log');
  const stderrLog = path.join(workerRoot, 'stderr.log');
  const codexLastMessage = path.join(workerRoot, 'codex-last-message.txt');
  const resultPath = path.join(workerRoot, 'result.json');
  const promptPath = path.join(workerRoot, 'prompt.md');

  fs.mkdirSync(workerRoot, { recursive: true });
  fs.writeFileSync(promptPath, promptText, 'utf8');
  fs.writeFileSync(stdoutLog, '');
  fs.writeFileSync(stderrLog, '');

  const argv = [
    ...buildCodexArgv({
      model: binding.model,
      repoRoot,
      permissionProfile: binding.permissionProfile,
      resultOutPath: codexLastMessage,
    }),
    promptText,
  ];

  const child = spawn(argv[0], argv.slice(1), {
    cwd: repoRoot,
    env: workerEnv('codex'),
    stdio: ['ignore', 'pipe', 'pipe'],
  });

  eventSink.emit('worker.spawned', {
    runId,
    stepId,
    workerId,
    runtime: 'codex',
    model: binding.model,
    pid: child.pid,
    cwd: repoRoot,
    argv,
  });
  onWorkerSpawned?.({ pid: child.pid });

  const timeout = setTimeout(() => {
    eventSink.emit('worker.timeout', { runId, stepId, workerId, pid: child.pid });
    child.kill('SIGTERM');
    setTimeout(() => child.kill('SIGKILL'), 5000);
  }, taskSpec.timeout);

  const exitCode = await new Promise((resolve, reject) => {
    child.stdout.on('data', (buf) => {
      const chunk = buf.toString();
      appendChunk(stdoutLog, chunk);
      eventSink.emit('worker.output', {
        runId,
        stepId,
        workerId,
        stream: 'stdout',
        chunk,
      });
    });
    child.stderr.on('data', (buf) => {
      const chunk = buf.toString();
      appendChunk(stderrLog, chunk);
      eventSink.emit('worker.stderr', {
        runId,
        stepId,
        workerId,
        stream: 'stderr',
        chunk,
      });
    });
    child.on('error', reject);
    child.on('close', (code) => {
      clearTimeout(timeout);
      resolve(code ?? 1);
    });
  });

  let text = '';
  if (fs.existsSync(codexLastMessage)) {
    text = fs.readFileSync(codexLastMessage, 'utf8').trim();
  }
  if (!text && fs.existsSync(stdoutLog)) {
    text = fs.readFileSync(stdoutLog, 'utf8').trim();
  }

  const stderrText = fs.existsSync(stderrLog) ? fs.readFileSync(stderrLog, 'utf8') : '';
  const shellInvoked = detectCodexShellInvocation(stderrText);
  const shellMutationInvoked = shellInvoked
    ? detectCodexShellMutation(stderrText)
    : false;
  const readSignals = accumulateCodexReadSignals(stderrText);

  const result = {
    ok: exitCode === 0 && text.length >= 32,
    text: text || '(empty)',
    format: 'markdown',
    exitCode,
    runtime: 'codex',
    model: binding.model,
    cliVersion: null,
    nativeSessionId: null,
    signals: { shellInvoked, shellMutationInvoked, ...readSignals },
  };

  fs.writeFileSync(resultPath, JSON.stringify(result, null, 2), 'utf8');

  if (exitCode === 0 && result.ok) {
    eventSink.emit('worker.completed', { runId, stepId, workerId, exitCode });
  } else {
    eventSink.emit('worker.failed', {
      runId,
      stepId,
      workerId,
      exitCode,
      reason: 'exit_or_empty',
    });
  }

  return { exitCode, resultPath, processExited: true };
}
import { spawn } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { buildClaudeArgv, workerEnv } from '../permissions.mjs';
import {
  accumulateClaudeSignals,
  appendChunk,
  extractClaudeStreamText,
} from './stream.mjs';

export async function runClaudeWorker({
  binding,
  taskSpec,
  workerRoot,
  repoRoot,
  promptText,
  eventSink,
  workerId,
  runId,
  stepId,
  onWorkerSpawned,
}) {
  const stdoutLog = path.join(workerRoot, 'stdout.log');
  const stderrLog = path.join(workerRoot, 'stderr.log');
  const resultPath = path.join(workerRoot, 'result.json');
  const promptPath = path.join(workerRoot, 'prompt.md');

  fs.mkdirSync(workerRoot, { recursive: true });
  fs.writeFileSync(promptPath, promptText, 'utf8');
  fs.writeFileSync(stdoutLog, '');
  fs.writeFileSync(stderrLog, '');

  const argv = buildClaudeArgv({
    model: binding.model,
    permissionProfile: binding.permissionProfile,
    repoRoot,
  });

  const child = spawn(argv[0], argv.slice(1), {
    cwd: repoRoot,
    env: workerEnv('claude'),
    stdio: ['pipe', 'pipe', 'pipe'],
  });

  eventSink.emit('worker.spawned', {
    runId,
    stepId,
    workerId,
    runtime: 'claude',
    model: binding.model,
    pid: child.pid,
    cwd: repoRoot,
    argv,
  });
  onWorkerSpawned?.({ pid: child.pid });

  child.stdin.write(promptText);
  child.stdin.end();

  let aggregatedText = '';
  let terminalResultText = null;
  let lineBuf = '';
  const signals = { readAttempts: 0, readSuccess: 0, readDenied: 0 };

  const timeout = setTimeout(() => {
    eventSink.emit('worker.timeout', { runId, stepId, workerId, pid: child.pid });
    child.kill('SIGTERM');
    setTimeout(() => child.kill('SIGKILL'), 5000);
  }, taskSpec.timeout);

  await new Promise((resolve, reject) => {
    child.stdout.on('data', (buf) => {
      const chunk = buf.toString();
      appendChunk(stdoutLog, chunk);
      eventSink.emit('worker.output', {
        runId,
        stepId,
        workerId,
        stream: 'stdout',
        chunk,
      });

      lineBuf += chunk;
      const lines = lineBuf.split('\n');
      lineBuf = lines.pop() ?? '';
      for (const line of lines) {
        if (!line.trim()) continue;
        accumulateClaudeSignals(line, signals);
        const { chunk, terminalResult } = extractClaudeStreamText(line);
        if (terminalResult) terminalResultText = terminalResult;
        if (chunk) aggregatedText += chunk;
      }
    });

    child.stderr.on('data', (buf) => {
      const chunk = buf.toString();
      appendChunk(stderrLog, chunk);
      eventSink.emit('worker.stderr', {
        runId,
        stepId,
        workerId,
        stream: 'stderr',
        chunk,
      });
    });

    child.on('error', reject);
    child.on('close', (code) => {
      clearTimeout(timeout);
      resolve(code ?? 1);
    });
  });

  if (lineBuf.trim()) {
    accumulateClaudeSignals(lineBuf, signals);
    const { chunk, terminalResult } = extractClaudeStreamText(lineBuf);
    if (terminalResult) terminalResultText = terminalResult;
    if (chunk) aggregatedText += chunk;
  }

  const exitCode = child.exitCode ?? 1;
  const text = (terminalResultText ?? aggregatedText).trim();

  const result = {
    ok: exitCode === 0,
    text: text || '(empty)',
    format: 'markdown',
    exitCode,
    runtime: 'claude',
    model: binding.model,
    cliVersion: null,
    nativeSessionId: null,
    signals,
  };

  fs.writeFileSync(resultPath, JSON.stringify(result, null, 2), 'utf8');

  if (exitCode === 0) {
    eventSink.emit('worker.completed', { runId, stepId, workerId, exitCode, signals });
  } else {
    eventSink.emit('worker.failed', {
      runId,
      stepId,
      workerId,
      exitCode,
      reason: 'nonzero_exit',
    });
  }

  return { exitCode, resultPath, processExited: true };
}

