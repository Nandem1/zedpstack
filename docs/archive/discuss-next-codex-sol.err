    13	export function defaultModelSheetPath() {
    14	  const cursor = path.join(os.homedir(), '.cursor', 'rules', 'pstack-models.mdc');
    15	  if (fs.existsSync(cursor)) return cursor;
    16	  const plain = path.join(os.homedir(), '.cursor', 'rules', 'pstack-models.md');
    17	  if (fs.existsSync(plain)) return plain;
    18	  return path.join(os.homedir(), '.zedpstack', 'pstack-models.md');
    19	}
    20	
    21	export function readModelSheet(filePath) {
    22	  const resolved = path.resolve(filePath);
    23	  if (!fs.existsSync(resolved)) {
    24	    return { path: resolved, text: defaultSheetTemplate(), exists: false };
    25	  }
    26	  let text = fs.readFileSync(resolved, 'utf8');
    27	  if (resolved.endsWith('.mdc')) {
    28	    text = text.replace(/^---[\s\S]*?---\s*/m, '');
    29	  }
    30	  return { path: resolved, text, exists: true };
    31	}
