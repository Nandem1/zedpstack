import { describe, it } from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { applyModelSheetToConfig } from '../src/setupConfig.mjs';

describe('setupConfig', () => {
  it('applyModelSheetToConfig surfaces panel overflow and dropped sheet lines', () => {
    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'zedpstack-setup-'));
    const sheetPath = path.join(tmp, 'pstack-models.md');
    const configPath = path.join(tmp, 'zedpstack.config.json');

    fs.writeFileSync(
      sheetPath,
      `architect runners: opus, fable, sonnet
line without colon is dropped
how explorer: haiku
`,
      'utf8',
    );

    const result = applyModelSheetToConfig({ sheetPath, configPath });

    assert.deepEqual(result.droppedLines, ['line without colon is dropped']);
    assert.equal(result.overflows.length, 1);
    assert.equal(result.overflows[0].model, 'sonnet');
    assert.equal(result.overflowWarnings.length, 1);
    assert.equal(result.rolesUpdated.includes('architect-runner-a'), true);
    assert.equal(result.rolesUpdated.includes('architect-runner-b'), true);

    const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    assert.equal(config.roles['architect-runner-b'].model, 'fable');
  });
});
import { describe, it } from 'node:test';
import assert from 'node:assert/strict';
import {
  bindingsFromSheet,
  inferRuntimeForModel,
  parseModelSheet,
  parseModelValue,
  sheetBindingOverflowWarnings,
} from '../src/modelSheet.mjs';

describe('modelSheet', () => {
  it('parses effort suffix', () => {
    assert.deepEqual(parseModelValue('opus @high'), { model: 'opus', effort: 'high' });
  });

  it('maps sheet to zedpstack bindings', () => {
    const parsed = parseModelSheet(`
how explorer: haiku
how explainer: gpt-6.1-sol
interrogate reviewers: haiku, gpt-6.1-sol, haiku
default effort: session
`);
    const { bindings } = bindingsFromSheet(parsed);
    assert.equal(bindings['how-explorer'].runtime, 'claude');
    assert.equal(bindings['how-explainer'].runtime, 'codex');
    assert.equal(bindings['interrogate-reviewer-b'].model, 'gpt-6.1-sol');
  });

  it('infers codex for gpt slugs', () => {
    assert.equal(inferRuntimeForModel('gpt-6.1-sol'), 'codex');
    assert.equal(inferRuntimeForModel('haiku'), 'claude');
  });

  it('parseModelSheet records lines without a role separator as dropped', () => {
    const parsed = parseModelSheet(`
how explorer: haiku
this line has no colon
# comment ignored
---
orphan value
reflect judgment: opus
`);
    assert.deepEqual(parsed.droppedLines, [
      'this line has no colon',
      'orphan value',
    ]);
    assert.equal(parsed.roles['how explorer']?.[0], 'haiku');
    assert.equal(parsed.roles['reflect judgment']?.[0], 'opus');
  });

  it('canonical reflect line with one model binds judgment, divergent, and synthesize', () => {
    const parsed = parseModelSheet(
      'reflect judgment, divergent, synthesizer: cursor-grok-4.6-high\n',
    );
    const { bindings, overflows } = bindingsFromSheet(parsed);
    assert.equal(overflows.length, 0);
    assert.equal(bindings['reflect-reviewer-judgment'].model, 'cursor-grok-4.6-high');
    assert.equal(bindings['reflect-reviewer-divergent'].model, 'cursor-grok-4.6-high');
    assert.equal(bindings['reflect-synthesize'].model, 'cursor-grok-4.6-high');
  });

  it('architect runners overflow reports extra models without overwriting slot b', () => {
    const parsed = parseModelSheet('architect runners: opus, fable, sonnet\n');
    const { bindings, overflows } = bindingsFromSheet(parsed);
    assert.equal(bindings['architect-runner-a'].model, 'opus');
    assert.equal(bindings['architect-runner-b'].model, 'fable');
    assert.deepEqual(overflows, [
      { sheetRole: 'architect runners', model: 'sonnet', index: 2 },
    ]);
    const warnings = sheetBindingOverflowWarnings(overflows);
    assert.equal(warnings.length, 1);
    assert.match(warnings[0], /architect runners/);
    assert.match(warnings[0], /sonnet/);
  });
});
import { describe, it } from 'node:test';
import assert from 'node:assert/strict';
import { resolveRoleBinding, resolveRoleBindingKey, resolveTimeout } from '../src/config.mjs';

describe('resolveRoleBinding', () => {
  const config = {
    data: {
      roles: {
        explorer: {
          runtime: 'claude',
          model: 'haiku',
          permissionProfile: 'read-only',
        },
        'interrogate-reviewer': {
          runtime: 'claude',
          model: 'sonnet',
          permissionProfile: 'read-only',
          effort: 'high',
        },
      },
      timeouts: {
        explorer: 120_000,
      },
    },
  };

  it('follows alias chain to binding', () => {
    assert.equal(
      resolveRoleBindingKey(config.data.roles, 'interrogate-reviewer-a'),
      'interrogate-reviewer',
    );
    const b = resolveRoleBinding(config, 'interrogate-reviewer-c');
    assert.equal(b.model, 'sonnet');
    assert.equal(b.effort, 'high');
  });

  it('resolves timeout through alias chain', () => {
    assert.equal(resolveTimeout(config, 'interrogate-reviewer-b'), 120_000);
  });
});
import { describe, it } from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { EventSink } from '../src/events/sink.mjs';

describe('EventSink stream filtering', () => {
  it('does not persist worker.output by default', () => {
    const runRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'zp-events-'));
    const sink = new EventSink(runRoot);
    sink.emit('run.started', { runId: 'r1' });
    sink.emit('worker.output', { chunk: 'noise' });
    const lines = fs.readFileSync(path.join(runRoot, 'events.jsonl'), 'utf8').trim().split('\n');
    assert.equal(lines.length, 1);
    assert.match(lines[0], /run\.started/);
  });

  it('persists worker.output when persistWorkerStream is true', () => {
    const runRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'zp-events-'));
    const sink = new EventSink(runRoot, { persistWorkerStream: true });
    sink.emit('worker.output', { chunk: 'x' });
    const lines = fs.readFileSync(path.join(runRoot, 'events.jsonl'), 'utf8').trim().split('\n');
    assert.equal(lines.length, 1);
  });
});
import { describe, it } from 'node:test';
import assert from 'node:assert/strict';
import { extractClaudeStreamText } from '../src/runtimes/stream.mjs';

describe('claude stream dedupe', () => {
  it('prefers terminal result event over assistant chunks', () => {
    const assistant = JSON.stringify({
      type: 'assistant',
      message: { content: [{ type: 'text', text: 'Hello world repeated' }] },
    });
    const terminal = JSON.stringify({
      type: 'result',
      result: 'Hello world repeated',
    });
    const a = extractClaudeStreamText(assistant);
    const t = extractClaudeStreamText(terminal);
    assert.equal(a.chunk, 'Hello world repeated');
    assert.equal(t.terminalResult, 'Hello world repeated');
  });
});

