    40	/**
    41	 * @param {string} slugWithOptionalEffort e.g. "haiku @high" or "gpt-6.1-sol"
    42	 */
    43	export function parseModelValue(raw) {
    44	  const trimmed = raw.trim();
    45	  if (!trimmed || trimmed === 'inherit-parent' || trimmed === 'auto') {
    46	    return { model: trimmed, effort: null };
    47	  }
    48	  const at = trimmed.lastIndexOf(' @');
    49	  if (at > 0) {
    50	    const model = trimmed.slice(0, at).trim();
    51	    const effort = trimmed.slice(at + 2).trim().toLowerCase();
    52	    if (EFFORT_LEVELS.has(effort)) {
    53	      return { model, effort };
    54	    }
    55	  }
    56	  return { model: trimmed, effort: null };
    57	}
