{
  "id": "architect-sketch",
  "version": 1,
  "description": "pstack architect Phase A+B read-only: ground (how) + 2 or 3 runners + synthesize",
  "upstream": { "pstackSkill": "architect" },
  "steps": [
    {
      "id": "ground",
      "role": "architect-ground",
      "promptSource": "pstack-how-explorer",
      "outputContract": "markdown-report"
    },
    {
      "id": "sketch-a",
      "role": "architect-runner-a",
      "promptSource": "pstack-architect-runner",
      "promptMeta": { "candidateLabel": "A" },
      "inputFrom": ["ground"],
      "outputContract": "markdown-report"
    },
    {
      "id": "sketch-b",
      "role": "architect-runner-b",
      "promptSource": "pstack-architect-runner",
      "promptMeta": { "candidateLabel": "B" },
      "inputFrom": ["ground"],
      "outputContract": "markdown-report"
    },
    {
      "id": "sketch-c",
      "role": "architect-runner-c",
      "requiresExplicitBinding": true,
      "promptSource": "pstack-architect-runner",
      "promptMeta": { "candidateLabel": "C" },
      "inputFrom": ["ground"],
      "outputContract": "markdown-report"
    },
    {
      "id": "synthesize",
      "role": "architect-synthesize",
      "promptSource": "pstack-architect-synthesize",
      "inputFrom": ["sketch-a", "sketch-b", "sketch-c", "ground"],
      "outputContract": "markdown-report"
    }
  ],
  "judgment": {
    "promptTemplate": "judgment.md",
    "artifact": "orchestrator-judgment.md"
  }
}
